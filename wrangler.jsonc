{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "carvaluation-co-za",
  "main": "src/index.js",
  "compatibility_date": "2026-08-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "carvaluation.co.za/*",
      "zone_name": "carvaluation.co.za"
    }
  ]
}
